# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# PostgreSQL connection string.
# When running the MCP server in Docker, use host.docker.internal instead of
# localhost so the container can reach your local Postgres.
#
# Local Postgres (Postgres.app / Homebrew):
DATABASE_URI=postgresql://username:password@host.docker.internal:5432/dbname
#
# Local Postgres via socket (not supported from Docker — use TCP above):
# DATABASE_URI=postgresql://username@/dbname
#
# Cloud / remote Postgres:
# DATABASE_URI=postgresql://username:password@your-db-host:5432/dbname?sslmode=require

# Access mode for the MCP server.
# unrestricted - full read/write access (recommended for local dev)
# restricted   - read-only (safer for shared/production databases)
ACCESS_MODE=unrestricted
